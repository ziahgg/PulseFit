# PulseFit environment variables. Copy to .env.local for development.
# All three are PUBLIC values (safe in the browser bundle). No service-role / secret key is used.

# Supabase project URL.
#   Local:  printed by `npx supabase start` as API_URL (http://127.0.0.1:55321 with this repo's config)
#   Hosted: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_…). The legacy anon key also works via
# NEXT_PUBLIC_SUPABASE_ANON_KEY if your project still uses it.
#   Local:  PUBLISHABLE_KEY from `npx supabase start`
#   Hosted: Dashboard → Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute site URL used in auth emails (confirm sign-up, reset password).
# Must match an allowed Redirect URL in Supabase Auth settings.
#   Local: http://localhost:3000   Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
